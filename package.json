{
  "name": "@mridang/vite-plugin-nuxt-module",
  "version": "0.1.1",
  "type": "module",
  "scripts": {
    "prepack": "tsc",
    "build": "tsc",
    "test": "jest --verbose --config=jest.config.mjs",
    "test:watch": "npm run test -- --watch",
    "test:debug": "jest --verbose --config=jest.config.mjs --detectOpenHandles",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "npx eslint .",
    "lint:fix": "npx eslint . --fix"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "keywords": [
    "vite",
    "vite-plugin",
    "nuxt",
    "nuxt-module"
  ],
  "author": {
    "name": "Mridang Agarwalla",
    "email": "mridang.agarwalla@gmail.com",
    "url": "https://github.com/mridang"
  },
  "files": [
    "dist"
  ],
  "license": "Apache-2.0",
  "description": "A Vite plugin that builds a Nuxt module the way @nuxt/module-builder does: a bundled module with declarations, a per-file runtime, module.json and types.d.mts",
  "private": false,
  "peerDependencies": {
    "@nuxt/kit": ">=3",
    "@nuxt/schema": ">=3",
    "nuxt": ">=3",
    "sass": ">=1",
    "sass-embedded": ">=1",
    "typescript": ">=5",
    "vite": ">=8",
    "vue-sfc-transformer": ">=0.1",
    "vue-tsc": ">=2"
  },
  "peerDependenciesMeta": {
    "@nuxt/kit": {
      "optional": true
    },
    "@nuxt/schema": {
      "optional": true
    },
    "nuxt": {
      "optional": true
    },
    "sass": {
      "optional": true
    },
    "sass-embedded": {
      "optional": true
    },
    "typescript": {
      "optional": true
    },
    "vue-sfc-transformer": {
      "optional": true
    },
    "vue-tsc": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mridang/vite-plugin-nuxt-module.git"
  },
  "homepage": "https://github.com/mridang/vite-plugin-nuxt-module",
  "bugs": "https://github.com/mridang/vite-plugin-nuxt-module/issues",
  "dependencies": {
    "picomatch": "^4.0.4",
    "rolldown": "^1.2.12",
    "rolldown-plugin-dts": "^0.28.6"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@babel/core": "^8.0.7",
    "@eslint/compat": "^2.1.0",
    "@jest/globals": "^30.0.3",
    "@mridang/eslint-defaults": "^1.6.3",
    "@nuxt/kit": "^4.5.1",
    "@nuxt/schema": "^4.5.1",
    "@nuxt/test-utils": "^4.3.4",
    "@semantic-release/commit-analyzer": "^13.0.1",
    "@semantic-release/git": "^11.0.1",
    "@semantic-release/github": "^12.0.0",
    "@semantic-release/npm": "^13.1.1",
    "@semantic-release/release-notes-generator": "^14.1.0",
    "@tsconfig/node22": "^22.0.2",
    "@types/jest": "^30.0.0",
    "@types/node": "^26.6.5",
    "@types/picomatch": "^4.0.2",
    "eslint": "^10.13.0",
    "h3": "^2.0.7",
    "jest": "^30.0.3",
    "jest-junit": "^17.0.0",
    "knip": "^6.17.1",
    "nuxt": "^4.5.1",
    "prettier": "^3.1.1",
    "publint": "^0.3.25",
    "sass": "^1.106.1",
    "semantic-release": "^25.0.1",
    "ts-jest": "^29.4.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.1",
    "vue": "^3.5.42",
